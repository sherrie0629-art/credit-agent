# Copy to .env / Lovable Cloud Secrets. Never commit real values.
# Supabase / Lovable keys omitted here — see existing project env.

# Google Ads test API (server-only; never VITE_)
GOOGLE_ADS_MODE=off
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
# Required on many China networks (Vite loads this into server process.env)
GOOGLE_ADS_PROXY=socks5h://127.0.0.1:10886
