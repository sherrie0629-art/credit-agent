# Copy to .env. Never commit real values.
#
# 本地（Cursor）只读调试所需的四行。前两行给浏览器，后两行给服务端渲染 /
# server function（读取 process.env，不能带 VITE_ 前缀）。缺少后两行时首屏没有数据。
# 值直接沿用 Lovable 项目 .env 中已有的 URL 与 publishable key（公开密钥，可放本地）。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# SUPABASE_SERVICE_ROLE_KEY 由 Lovable Cloud 只在云端注入，本地拿不到，也不要写在这里。
# 本地因此是只读模式：仪表盘数据可正常读取，写入类操作会提示去云端预览验证。


# Google Ads test API (server-only; never VITE_)
#
# 双环境说明：同名变量在「本地 .env」和「Lovable Cloud Secrets」各存一份，
# 配好后来回切换零操作——代码只读 process.env，谁给值就用谁的，
# 不需要改开关、不需要注释代码。
#   - Cursor 本地：读下面这份 .env（npm run dev 自动加载）
#   - Lovable 云端：读 Cloud Secrets（预览/发布运行时注入）
GOOGLE_ADS_MODE=off
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
# 仅本地需要（很多国内网络无法直连 googleads.googleapis.com）。
# 云端 Worker 不能用 SOCKS，务必【不要】在 Cloud Secrets 里配置这一项，否则探活会超时。
GOOGLE_ADS_PROXY=socks5h://127.0.0.1:10886
