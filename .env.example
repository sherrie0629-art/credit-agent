# Copy to .env. Never commit real values.
#
# 本地（Cursor）只读调试所需的四行。前两行给浏览器，后两行给服务端渲染 /
# server function（读取 process.env，不能带 VITE_ 前缀）。缺少后两行时首屏没有数据。
# 值直接沿用 Lovable 项目 .env 中已有的 URL 与 publishable key（公开密钥，可放本地）。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
#
# SUPABASE_SERVICE_ROLE_KEY 由 Lovable Cloud 只在云端注入，本地拿不到，也不要写在这里。
# 本地因此是只读模式：仪表盘数据可正常读取，写入类操作会提示去云端预览验证。


# Google Ads test API (server-only; never VITE_)
GOOGLE_ADS_MODE=off
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
# Required on many China networks (Vite loads this into server process.env)
GOOGLE_ADS_PROXY=socks5h://127.0.0.1:10886
